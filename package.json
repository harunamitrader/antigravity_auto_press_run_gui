{
  "name": "antigravity-auto-press-run-gui",
  "private": true,
  "version": "1.0.0",
  "description": "Auto Press Run for Antigravity",
  "author": "Harunami Trader",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron', {recursive:true}); fs.copyFileSync('electron/preload.ts', 'dist-electron/preload.cjs')\" && vite",
    "build": "tsc -b && vite build && node -e \"const fs=require('fs'); fs.mkdirSync('dist-electron', {recursive:true}); fs.copyFileSync('electron/preload.ts', 'dist-electron/preload.cjs')\"",
    "lint": "eslint .",
    "package": "npm run build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "chrome-remote-interface": "^0.34.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@types/chrome-remote-interface": "^0.33.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "commander": "^14.0.3",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "ws": "^8.19.0"
  },
  "build": {
    "appId": "com.harunamitrader.antigravityautopressrun",
    "productName": "Antigravity Auto Press Run",
    "directories": {
      "output": "release"
    },
    "npmRebuild": false,
    "asar": false,
    "win": {
      "target": "dir",
      "icon": "public/favicon.png"
    }
  }
}